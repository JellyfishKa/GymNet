# Скопируйте нужные строки в environment сервиса backend (docker-compose.yml)
# или задайте локально перед uvicorn.

# --- Разделение отжиманий / приседаний ---
# Чем меньше max_torso_span, тем строже «горизонтальность» для отжиманий (0.12–0.18).
GYMNET_PUSHUP_MAX_TORSO_SPAN=0.15
# Чем больше min_torso_span, тем строже «вертикальность» для приседаний (0.10–0.16).
GYMNET_SQUAT_MIN_TORSO_SPAN=0.12
# Минимальный разрыв score между 1-м и 2-м классом; иначе tie-break по корпусу.
GYMNET_CLASSIFY_MIN_MARGIN=0.12
# Если ML и эвристика спорят, эвристика побеждает при разнице score >= этого порога.
GYMNET_HEURISTIC_OVERRIDE_MARGIN=0.22

# --- Lockout (полное выпрямление) ---
GYMNET_PUSHUP_STANDING_MIN_ANGLE=168
GYMNET_PUSHUP_BOTTOM_MAX_ANGLE=85
GYMNET_PUSHUP_BOTTOM_MIN_ELBOW_DROP=0.07
GYMNET_PUSHUP_STANDING_MIN_ARM_EXTENSION=0.09
GYMNET_PUSHUP_STANDING_MAX_ELBOW_DROP=0.05

GYMNET_SQUAT_STANDING_MIN_ANGLE=168
GYMNET_SQUAT_BOTTOM_MAX_ANGLE=95
GYMNET_SQUAT_TRANSITION_UP_MIN=140

# --- Активность в зоне (не считать стоящих / проходящих) ---
GYMNET_ACTIVITY_MIN_HIP_Y_STD=0.012
GYMNET_ACTIVITY_MAX_HIP_X_RANGE=0.14
